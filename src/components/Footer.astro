---
import { ArrowRight, Phone } from '@lucide/astro';
import { Image } from 'astro:assets';
import { site, photos } from '../data/site';

const home = Astro.url.pathname === '/';
const section = (hash: string) => home ? hash : `/${hash}`;
const links = [
  { label: 'Location', href: section('#location') },
  { label: 'Rooms', href: '/rooms/' },
  { label: 'Amenities', href: section('#amenities') },
  { label: 'Reviews', href: section('#reviews') },
  { label: 'Explore', href: section('#explore') },
  { label: 'FAQ', href: section('#faq') },
];
---

<section class="contact-section" id="contact">
  <div class="contact-section__background">
    <Image
      src={photos.loungePanorama.src}
      width={1080}
      widths={[480, 720, 1080, 1440, 1700]}
      sizes="100vw"
      alt=""
      format="webp"
      quality={80}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="shell contact-section__inner">
    <div class="contact-copy" data-reveal>
      <span class="eyebrow eyebrow--light">CONTACT THE HOTEL</span>
      <h2>Make your next<br />stay a little easier.</h2>
      <p>
        Have a date in mind? Call Marlin Hotel to confirm room availability,
        the current price and directions.
      </p>
      <div class="contact-actions">
        <a class="button button--white" href={`tel:${site.phoneE164}`}>
          Call Reception <Phone size={17} />
        </a>
        <a
          class="button button--transparent"
          href={site.directions}
          target="_blank"
          rel="noopener noreferrer"
        >
          Get Directions <ArrowRight size={17} />
        </a>
      </div>
    </div>

    <div class="contact-details" data-reveal>
      <div>
        <small>HOTEL PHONE · PUBLIC LISTING</small>
        <a href={`tel:${site.phoneE164}`}>
          {site.phoneDisplay} <ArrowRight size={18} />
        </a>
      </div>
      <div>
        <small>ADDRESS · PUBLIC LISTING</small>
        <address>{site.address}</address>
      </div>
      <div>
        <small>RESERVATIONS</small>
        <p>Rates and availability confirmed directly with reception.</p>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-brand">
      <a class="brand brand--footer" href={home ? '#top' : '/'} aria-label="Marlin Hotel homepage">
        <img
          class="brand__image"
          src="/branding/marlin-logo-footer.svg"
          alt="Marlin Hotel & Suite"
          width="165"
          height="60"
          decoding="async"
        />
      </a>
      <p>A comfortable place to stay, with welcoming spaces and room to unwind.</p>
    </div>

    <div class="footer-links">
      <h3>EXPLORE</h3>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <div class="footer-links">
      <h3>GET IN TOUCH</h3>
      <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>
      <a href={site.directions} target="_blank" rel="noopener noreferrer">
        Get directions <ArrowRight size={15} />
      </a>
      <span>{site.neighborhood}<br />Lagos, Nigeria</span>
    </div>

    <div class="footer-links">
      <h3>FIND US ON SOCIALS</h3>
      <div class="footer-socials" aria-label="Social media platforms">
        <a
          class="footer-socials__icon"
          href="https://www.instagram.com/explore/search/keyword/?q=Marlin%20Hotel%20and%20Suites%20Lagos"
          target="_blank"
          rel="noopener noreferrer"
          title="Find Marlin Hotel on Instagram"
          aria-label="Search Instagram for Marlin Hotel and Suites"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>

        <a
          class="footer-socials__icon"
          href="https://www.facebook.com/search/pages/?q=Marlin%20Hotel%20and%20Suites%20Lagos"
          target="_blank"
          rel="noopener noreferrer"
          title="Find Marlin Hotel on Facebook"
          aria-label="Search Facebook for Marlin Hotel and Suites"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.19 2.23.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
          </svg>
        </a>

        <a
          class="footer-socials__icon"
          href="https://www.youtube.com/results?search_query=Marlin+Hotel+and+Suites+Lagos"
          target="_blank"
          rel="noopener noreferrer"
          title="Find Marlin Hotel on YouTube"
          aria-label="Search YouTube for Marlin Hotel and Suites"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="5" width="20" height="14" rx="4" />
            <path d="m10 9 5 3-5 3z" />
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Marlin Hotel. All rights reserved.</span>
    <div class="footer-bottom__legal">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/terms-and-conditions/">Terms &amp; Conditions</a>
    </div>
  </div>
</footer>

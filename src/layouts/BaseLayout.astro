---
import '../styles/global.css';
import '../styles/rooms.css';
import { absoluteSiteURL } from '../data/seo';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import { ArrowUp } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}
const {
  title = 'Marlin Hotel & Suites | Rooms & Stays in Lagos',
  ogImage,
  noindex = false,
  description = 'Explore rooms, rates and facilities at Marlin Hotel & Suites in Abule Ado, Lagos. Send booking enquiries directly.',
} = Astro.props;
const canonical = absoluteSiteURL(Astro.url.pathname);
const defaultSocialImage = '/marlin-social.jpg';
const socialImage = absoluteSiteURL(ogImage || defaultSocialImage);
const socialDescription = description.length <= 125
  ? description
  : `${description.slice(0, 122).replace(/\s+\S*$/, '').trimEnd()}...`;
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ed" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && !ogImage && <meta property="og:image:width" content="1200" />}
    {socialImage && !ogImage && <meta property="og:image:height" content="630" />}
    {socialImage && !ogImage && <meta property="og:image:type" content="image/jpeg" />}
    {socialImage && !ogImage && <meta property="og:image:alt" content="Marlin Hotel & Suites exterior in Abule Ado, Lagos" />}
    {socialImage && !ogImage && <meta name="twitter:image:alt" content="Marlin Hotel & Suites exterior in Abule Ado, Lagos" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('marlin-intro-seen')) {
          document.documentElement.classList.add('intro-play');
          sessionStorage.setItem('marlin-intro-seen', '1');
        }
      } catch (_) { /* Storage may be disabled. Keep the website usable. */ }
    </script>
  </head>
  <body>
    <noscript><style>
      @media (max-width: 1024px) {
        .site-header { height: auto !important; }
        .mobile-menu-toggle { display: none !important; }
        .mobile-nav { display: flex !important; position: static !important; opacity: 1 !important; visibility: visible !important; transform: none !important; height: auto !important; }
      }
    </style></noscript>
    <div class="site-loader" aria-hidden="true">
      <div class="site-loader__inner"><img class="loader-brand-icon" src="/branding/marlin-icon.svg" alt="" width="88" height="88" /><span>MARLIN HOTEL</span></div>
      <span class="site-loader__caption">ABULE ADO · LAGOS</span>
    </div>
    <Header />
    <div id="smooth-wrapper"><div id="smooth-content"><slot /></div></div>
    <a class="back-to-top" href={Astro.url.pathname.startsWith('/rooms/') || Astro.url.pathname === '/' ? '#top' : '#smooth-content'} aria-label="Back to top" data-back-to-top><ArrowUp size={20} stroke-width={1.8}/></a>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

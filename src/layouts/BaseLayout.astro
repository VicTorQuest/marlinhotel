---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import { ArrowUp } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Marlin Hotel & Suites | Rooms & Stays in Lagos',
  description = 'Discover Marlin Hotel & Suites. Explore rooms, the hotel, amenities and guest experiences, with directions and direct booking enquiries.',
} = Astro.props;
---
<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ed" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('marlin-intro-seen')) {
          document.documentElement.classList.add('intro-play');
          sessionStorage.setItem('marlin-intro-seen', '1');
        }
      } catch (_) { /* Storage may be disabled. Keep the website usable. */ }
    </script>
  </head>
  <body>
    <noscript><style>
      @media (max-width: 1024px) {
        .site-header { height: auto !important; }
        .mobile-menu-toggle { display: none !important; }
        .mobile-nav { display: flex !important; position: static !important; opacity: 1 !important; visibility: visible !important; transform: none !important; height: auto !important; }
      }
    </style></noscript>
    <div class="site-loader" aria-hidden="true">
      <div class="site-loader__inner"><img class="loader-brand-icon" src="/branding/marlin-icon.svg" alt="" width="88" height="88" /><span>MARLIN HOTEL</span></div>
      <span class="site-loader__caption">ABULE ADO · LAGOS</span>
    </div>
    <Header />
    <div id="smooth-wrapper"><div id="smooth-content"><slot /></div></div>
    <a class="back-to-top" href="#top" aria-label="Back to top" data-back-to-top><ArrowUp size={20} stroke-width={1.8}/></a>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>

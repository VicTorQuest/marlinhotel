---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import { ArrowLeft, ArrowRight, Phone, MessageCircle } from '@lucide/astro';
import { photos, site } from '../../data/site';
import { rooms, roomName, rateLabel } from '../../data/rooms';
// Use the public reception WhatsApp number already maintained in site.ts.
const whatsappNumber = site.phoneE164.replace(/\D/g, '');
---
<BaseLayout title={`Booking Enquiry | ${site.name}`} description="Prepare a direct room booking enquiry with Marlin Hotel reception in Lagos." noindex>
  <main class="room-page booking-page shell" id="top">
    <a class="room-back" href="/rooms/"><ArrowLeft size={16}/> All rooms</a>
    <div class="booking-layout">
      <section class="booking-intro" aria-labelledby="booking-title" data-reveal>
        <span class="eyebrow">PLAN YOUR STAY</span><h1 class="display-heading" id="booking-title">A stay begins<br/>with a hello.</h1>
        <p class="body-copy">Share your dates and contact details so reception can confirm the right room, current price and availability.</p>
        <div class="booking-intro__photo"><Image src={photos.receptionWide.src} alt={photos.receptionWide.alt} width={720} widths={[400, 640, 720, 960, 1200]} sizes="(max-width: 780px) calc(100vw - 40px), 40vw" format="webp" quality={80} loading="lazy" /></div>
        <div class="booking-intro__contact"><span class="eyebrow">PREFER TO SPEAK TO US?</span><a href={`tel:${site.phoneE164}`}><Phone size={18}/> {site.phoneDisplay}</a><p>Reception will confirm the details of your reservation.</p></div>
      </section>
      <section class="booking-panel" aria-labelledby="enquiry-title" data-reveal>
        <span class="eyebrow">BOOKING ENQUIRY</span><h2 id="enquiry-title">Tell us about your visit.</h2><p class="booking-panel__intro">Required fields are marked with an asterisk.</p>
        <form data-booking-form data-whatsapp={whatsappNumber} method="post" autocomplete="on">
          <div class="booking-field"><label for="booking-room">Preferred room category</label><select name="room" id="booking-room"><option value="">Any suitable room</option>{rooms.map((room) => <option value={room.slug} data-label={roomName(room)} data-capacity={room.verifiedCapacity ?? ''}>{roomName(room)} · {rateLabel(room)}/night</option>)}</select><small>Reception will confirm the room and availability for your dates.</small></div>
          <div class="booking-fields booking-fields--two">
            <div class="booking-field"><label for="booking-checkin">Check-in *</label><input type="date" name="checkin" id="booking-checkin" required /></div>
            <div class="booking-field"><label for="booking-checkout">Check-out *</label><input type="date" name="checkout" id="booking-checkout" required /></div>
          </div>
          <div class="booking-field"><label for="booking-guests">Number of guests *</label><input type="number" name="guests" id="booking-guests" min="1" max="100" step="1" value="1" required inputmode="numeric" /><small data-guest-note>Reception will confirm suitable occupancy.</small></div>
          <div class="booking-fields booking-fields--two">
            <div class="booking-field"><label for="booking-name">Full name *</label><input name="guestName" id="booking-name" type="text" autocomplete="name" maxlength="100" required placeholder="Your full name" /></div>
            <div class="booking-field"><label for="booking-phone">Phone number *</label><input name="phone" id="booking-phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" required placeholder="+234 …" /><small>Include your country code where possible.</small></div>
          </div>
          <div class="booking-field"><label for="booking-email">Email <span>(optional)</span></label><input name="email" id="booking-email" type="email" autocomplete="email" maxlength="150" placeholder="you@example.com" /></div>
          <div class="booking-field"><label for="booking-notes">Special requests <span>(optional)</span></label><textarea name="notes" id="booking-notes" rows="3" maxlength="500" placeholder="Anything reception should know?"></textarea></div>
          <p class="booking-panel__privacy">Your details are prepared in your browser and are not stored by this website. Only share them with reception when you are ready. Read our <a href="/privacy-policy/">Privacy Policy</a>.</p>
          <button class="button button--dark booking-submit" type="submit" disabled data-booking-submit>Prepare booking enquiry <ArrowRight size={18}/></button>
          <noscript><p>Please enable JavaScript to prepare an enquiry, or call <a href={`tel:${site.phoneE164}`}>{site.phoneDisplay}</a>.</p></noscript>
          <p class="booking-panel__note">No payment is required. An enquiry does not confirm your reservation.</p>
        </form>
        <div class="booking-preview" data-booking-preview hidden aria-labelledby="preview-title">
          <h3 id="preview-title" tabindex="-1">Review your enquiry.</h3><p>Review your details, then open WhatsApp to send the prepared message to reception.</p>
          <label class="eyebrow" for="booking-message">YOUR MESSAGE</label><textarea id="booking-message" rows="8" readonly data-booking-message></textarea>
          <div class="booking-preview__actions">
            <a class="button button--dark" data-whatsapp-link target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"><MessageCircle size={18}/> Send enquiry via WhatsApp</a>
            <a class="button button--white" href={`tel:${site.phoneE164}`}><Phone size={17}/> Call reception</a>
          </div>
          <p class="booking-panel__note">WhatsApp will open with your enquiry prefilled. Press Send in WhatsApp to contact reception.</p>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
<script>
  import '../../scripts/booking';
</script>

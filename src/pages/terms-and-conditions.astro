---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms & Conditions | Marlin Hotel & Suites" description="Website terms and guest enquiry information for Marlin Hotel & Suites.">
  <main class="legal-page shell">
    <span class="eyebrow">MARLIN HOTEL &amp; SUITES</span>
    <h1>Terms &amp; Conditions</h1>
    <p>This website is provided to help visitors explore Marlin Hotel &amp; Suites and contact the property. Using it does not create a room reservation.</p>
    <h2>Room enquiries and reservations</h2>
    <p>Room types, rates, availability, inclusions, and booking conditions must be confirmed directly with hotel reception before making arrangements or payments.</p>
    <h2>Website information</h2>
    <p>Descriptions and photographs on the current website are presented for reference and may not represent the hotel's final room inventory or services. Confirm any important details with the hotel.</p>
    <h2>External websites</h2>
    <p>Links to Google Maps and other external websites are provided for convenience. Their content and availability are managed by their respective operators.</p>
    <a class="button button--dark" href="/">Return to homepage</a>
  </main>
</BaseLayout>
